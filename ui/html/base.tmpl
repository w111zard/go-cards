{{define "base"}}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,200..1000;1,200..1000&family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/static/css/tokens.css">
    <link rel="stylesheet" href="/static/css/base.css">
    <link rel="stylesheet" href="/static/css/layout.css">
    <link rel="stylesheet" href="/static/css/components/profile.css">
    <link rel="stylesheet" href="/static/css/components/deck.css">
</head>
<body>
   <header class="header">
    <div class="header__brand">
        <img class="header__logo" src="/static/img/logo.png" alt="">
        <p>Go Cards</p>
    </div>
    <a class="profile" href="">
        {{with .User}}<p class="profile__name">{{.Name}}</p>{{end}}
        <img class="profile__avatar" src="/static/img/profile.svg" alt="">
    </a>
   </header>
   <main class="main">
    {{template "main" .}}
   </main>
</body>
</html>
{{end}}
