{{define "main"}}
    <h1>Your decks</h1>
    <div class="deck-list">
        {{range .Decks}}
            <div class="deck">
                <img class="deck__cover" src="/static/img/default-cover.png" alt="">
                <p class="deck__name">{{.Name}}</p>
            </div>
        {{end}}
    </div>
{{end}}
